-- 7) อัปเดตรายชื่อผู้เล่นในเซิร์ฟเวอร์
local function updatePlayerList()
    for _, child in pairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local count = 0
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 35)
            btn.BackgroundColor3 = Color3.fromRGB(25, 32, 45)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
            btn.Font = Enum.Font.SourceSans
            btn.TextSize = 13
            btn.Parent = PlayerListScroll
            
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 6)
            c.Parent = btn
            
            btn.MouseButton1Click:Connect(function()
                selectedPlayerObj = plr
                PlayerInfoLbl.Text = plr.DisplayName .. " (@" .. plr.Name .. ")\n❤️ HP: 100/100\n🆔 ID: " .. plr.UserId
                AvatarImg.Image = Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
            end)
        end
    end
    PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, count * 40)
end

RefreshListBtn.MouseButton1Click:Connect(updatePlayerList)
updatePlayerList()

