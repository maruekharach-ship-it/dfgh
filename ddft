-- 1) ย้ายเซิร์ฟเวอร์คนน้อย (Server Hop)
ServerHopBtn.MouseButton1Click:Connect(function()
    ServerHopBtn.Text = "⚡ กำลังค้นหาเซิร์ฟ..."
    local api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(api)) end)
    
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id)
                return
            end
        end
    end
    ServerHopBtn.Text = "⚡ ย้ายเซิร์ฟ (คนน้อย)"
end)

-- 2) ESP Name & Tool
local function applyESP(plr)
    if plr == LocalPlayer or not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if head and not head:FindFirstChild("GeminiESP") then
        local bb = Instance.new("BillboardGui")
        bb.Name = "GeminiESP"
        bb.Size = UDim2.new(0, 200, 0, 50)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = head
        
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = Color3.fromRGB(255, 50, 50)
        txt.Font = Enum.Font.SourceSansBold
        txt.TextSize = 14
        txt.Parent = bb
        
        game:GetService("RunService").RenderStepped:Connect(function()
            if espEnabled and plr.Character and plr.Character:FindFirstChild("Head") then
                local tool = plr.Character:FindFirstChildOfClass("Tool")
                local toolName = tool and tool.Name or "None"
                txt.Text = plr.DisplayName .. " (@" .. plr.Name .. ")\n[Tool: " .. toolName .. "]"
                bb.Enabled = true
            else
                bb.Enabled = false
            end
        end)
    end
end

EspToggleBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        EspToggleBtn.Text = "🏷️ ESP Name & Tool: เปิด (ON)"
        EspToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 100)
        for _, p in pairs(Players:GetPlayers()) do applyESP(p) end
    else
        EspToggleBtn.Text = "🏷️ ESP Name & Tool: ปิด (OFF)"
        EspToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    end
end)

EspRefreshBtn.MouseButton1Click:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do applyESP(p) end
end)

